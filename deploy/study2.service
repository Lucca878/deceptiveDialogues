[Unit]
Description=Deceptive Dialogues Study 2 Flask app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/study2
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/study2/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8001 --access-logfile - --error-logfile - server:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
