[Unit]
Description=Deceptive Dialogues Study 2 Flask app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/study2
Environment=PYTHONUNBUFFERED=1
# The deployed participant run always requires entry verification; secrets and host allowlists remain external.
EnvironmentFile=-/etc/study2.env
Environment=TURNSTILE_ENABLED=true
# Keep the collection run ID and database location explicit and outside the checkout.
Environment=STUDY_RUN_ID=test
Environment=STUDY_DATABASE_URL=sqlite:////var/lib/study2/study2.sqlite
# Use the same editable condition and instruction configuration that deployment snapshots into metadata.
Environment=STUDY_CONFIG_PATH=/var/www/study2/config/study_test.json
ExecStart=/var/www/study2/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8001 --access-logfile - --error-logfile - server:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
